{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["ghidra"],
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(rg:*)",
      "Bash(xxd:*)",
      "Bash(shasum:*)",
      "Bash(bash docs/ghidra/gen-types.sh)",
      "Bash(bash docs/ghidra/gen-globals.sh)",
      "Bash(bash docs/ghidra/gen-signatures.sh)"
    ]
  }
}
